{
  "name": "@tutiengioi/live-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cầu nối: nguồn sự kiện (mô phỏng hoặc TikTok, chỉ đọc) → lõi game → màn hình OBS qua WebSocket.",
  "scripts": {
    "start": "node --experimental-transform-types --disable-warning=ExperimentalWarning src/main.ts",
    "sim": "node --experimental-transform-types --disable-warning=ExperimentalWarning src/main.ts --source sim",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "optionalDependencies": {
    "tiktok-live-connector": "2.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0"
  }
}
